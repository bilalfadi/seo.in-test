---
import Page from '../layouts/Page.astro';
import OriginalApp from '../components/OriginalApp';
import {DEFAULT_META} from '../../src/seo/site';
const robots=import.meta.env.PUBLIC_PRODUCTION_INDEXABLE==='true'?'index,follow':'noindex,nofollow';
---
<Page title={DEFAULT_META.title} description={DEFAULT_META.description} pathname="/" robots={robots}>
  <OriginalApp path="/" client:load />
</Page>
